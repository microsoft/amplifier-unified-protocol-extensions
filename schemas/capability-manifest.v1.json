{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-protocol-extensions/schemas/capability-manifest.v1.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "topics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "version": {
            "const": 1
          },
          "watch": {
            "type": "boolean"
          }
        },
        "required": [
          "uri",
          "version"
        ],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "method": {
            "const": "x-amplifier/capabilityAction"
          }
        },
        "required": [
          "topic",
          "operation",
          "method"
        ],
        "additionalProperties": false
      },
      "maxProperties": 1024
    }
  },
  "required": [
    "version",
    "topics",
    "actions"
  ],
  "additionalProperties": false
}
