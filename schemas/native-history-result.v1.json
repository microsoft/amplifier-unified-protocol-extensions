{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-protocol-extensions/schemas/native-history-result.v1.json",
  "type": "object",
  "properties": {
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sessionUpdate"
        ],
        "properties": {
          "sessionUpdate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "description": "Must also validate against the negotiated upstream ACP SessionUpdate schema."
      },
      "maxItems": 100000
    },
    "turnGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sessionUpdate"
              ],
              "properties": {
                "sessionUpdate": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "description": "Must also validate against the negotiated upstream ACP SessionUpdate schema."
            },
            "maxItems": 100000
          },
          "state": {
            "enum": [
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "updates",
          "state"
        ],
        "additionalProperties": false
      },
      "maxItems": 201
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "additionalProperties": true
      },
      "maxItems": 100000
    }
  },
  "required": [
    "updates",
    "nextCursor",
    "revision",
    "diagnostics"
  ],
  "additionalProperties": false
}
