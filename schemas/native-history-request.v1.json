{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-protocol-extensions/schemas/native-history-request.v1.json",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "sessionId",
    "cwd"
  ],
  "additionalProperties": false
}
