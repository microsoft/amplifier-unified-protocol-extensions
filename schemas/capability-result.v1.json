{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/amplifier-unified-protocol-extensions/schemas/capability-result.v1.json",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "boolean",
      "description": "Whether the owner accepted this action. This is not proof of readiness, execution or completed effects. Recover terminal outcomes through the original owner receipt; accepted:false alone does not prove executed:false."
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "topic",
          "scope",
          "revision",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "invalidate": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 128
    },
    "result": {},
    "_meta": {
      "type": "object"
    }
  },
  "required": [
    "accepted"
  ],
  "additionalProperties": false
}
