{
  "name": "@amplifier/unified-protocol-extensions",
  "version": "0.1.2",
  "description": "Negotiated capability contracts for Amplifier Unified AHP components",
  "type": "module",
  "license": "MIT",
  "files": [
    "schemas",
    "fixtures",
    "types",
    "registry.json",
    "README.md",
    "LICENSE",
    "docs",
    "scripts",
    "tests"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./registry.json"
    },
    "./registry.json": "./registry.json",
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "generate": "node scripts/generate-types.mjs",
    "check:generated": "node scripts/generate-types.mjs --check",
    "verify:peers": "node scripts/verify-peers.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/amplifier-unified-protocol-extensions.git"
  }
}
