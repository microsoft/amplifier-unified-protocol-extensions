{
  "version": 1,
  "upstream": {
    "ahp": {
      "version": "0.9.0",
      "source": "https://github.com/microsoft/agent-host-protocol",
      "revision": "9f940395ce28"
    },
    "acp": {
      "wireVersion": 1,
      "source": "https://github.com/agentclientprotocol/agent-client-protocol",
      "revision": "59172bafdf4b"
    }
  },
  "extensions": [
    {
      "namespace": "amplifier.dev/capabilities",
      "protocol": "ahp",
      "version": 1,
      "method": "x-amplifier/capabilityAction",
      "schemas": [
