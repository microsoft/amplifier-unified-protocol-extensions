      "methods": [
        "_amplifier/native",
        "_amplifier/history",
        "_amplifier/event"
      ],
      "schemas": [
        "native-request.v1",
        "native-history-request.v1",
        "native-history-result.v1"
      ]
    },
    {
      "namespace": "amplifier.dev/host",
      "protocol": "acp",
      "version": 1,
      "method": "_amplifier/host",
      "schemas": [
        "host-request.v1"
      ]
    }
  ]
